<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Atelier Inference Hub — Observability</title>
<script src="vendor/chart.umd.min.js"></script>
<link rel="stylesheet" href="vendor/gridstack.min.css" />
<script src="vendor/gridstack-all.js"></script>
<style>
  :root {
    --bg: #0E0E0E;
    --panel: #131312;
    --panel-2: #181816;
    --line: rgba(255,255,255,0.06);
    --line-strong: rgba(255,255,255,0.10);
    --gold: #C8A96E;
    --gold-dim: rgba(200,169,110,0.16);
    --text: #EDEAE3;
    --text-2: #9A958A;
    --text-3: #63605A;
    --up: #5FA86B;
    --busy: #C8A96E;
    --cold: #55524C;
    --warn: #C99A52;
    --cliff: #C2554B;
    --mono: "SF Mono", ui-monospace, "Berkeley Mono", Menlo, monospace;
    --sans: Inter, -apple-system, system-ui, "Segoe UI", Roboto, sans-serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body { height: 100%; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 13px;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  /* ---- Overall layout: 70 / 30 vertical split ---- */
  .grid {
    display: grid;
    grid-template-rows: 1fr minmax(220px, 30vh);
    height: 100vh;
    width: 100vw;
    gap: 1px;
    background: var(--line);
  }

  /* ---- MAIN (top 70%) : three panels ---- */
  .main {
    display: grid;
    grid-template-columns: 1.15fr 1fr 1.25fr;
    gap: 1px;
    background: var(--line);
    min-height: 0;
  }

  .panel {
    background: var(--bg);
    display: flex;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
  }

  .phead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 12px 16px 10px;
    border-bottom: 1px solid var(--line);
    flex: none;
  }

  .ptitle {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-2);
    font-weight: 600;
  }
  .ptitle .dot {
    display: inline-block;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--gold);
    margin-right: 8px;
    vertical-align: middle;
  }

  .pbody {
    flex: 1 1 auto;
    min-height: 0;
    padding: 14px 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* numeric readouts */
  .big-readout { text-align: right; }
  .big-readout .n {
    font-family: var(--mono);
    font-size: 30px;
    font-weight: 500;
    color: var(--gold);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .big-readout .u {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    margin-left: 3px;
  }
  .big-readout .sub {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text-2);
    margin-top: 3px;
  }

  /* charts fill remaining space */
  .chart-wrap { position: relative; flex: 1 1 auto; min-height: 0; }

  /* ---- Tenants card grid ---- */
  .tenant-grid {
    display: grid;
    /* auto-fit: cards reflow into as many equal columns as the panel width
       allows (more when wider, fewer when narrower) — even rows at any size */
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
    overflow-y: auto;
    align-content: start;
    padding-right: 2px;
  }
  .tcard {
    border: 1px solid var(--line-strong);
    background: var(--panel);
    padding: 10px 11px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tcard.busy {
    border-color: var(--gold-dim);
    animation: pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(200,169,110,0.0); border-color: rgba(200,169,110,0.18); }
    50% { box-shadow: 0 0 0 1px rgba(200,169,110,0.22); border-color: rgba(200,169,110,0.45); }
  }
  /* Routing control-tower panel */
  .route-bar { height:20px; border-radius:5px; overflow:hidden; display:flex; background:#1a1a18;
    border:1px solid var(--line); margin-bottom:12px; flex:0 0 auto; }
  .route-bar > span { display:flex; align-items:center; justify-content:center; font-size:9px;
    font-weight:600; overflow:hidden; white-space:nowrap; min-width:0; letter-spacing:.02em; }
  .route-grid { display:flex; gap:16px; flex:1 1 auto; min-height:0; }
  .route-col { flex:1 1 0; min-width:0; display:flex; flex-direction:column; min-height:0; }
  .route-col-wide { flex:1.5 1 0; }
  .route-h { font-size:8.5px; letter-spacing:.13em; text-transform:uppercase; color:var(--text-3);
    margin-bottom:7px; flex:0 0 auto; }
  .route-be { margin-bottom:9px; }
  .route-be-name { font-family:var(--mono); font-size:11px; color:var(--text);
    display:flex; justify-content:space-between; gap:8px; }
  .route-be-name .lease-n { color:var(--text-3); font-size:10px; }
  .route-be-models { font-size:10px; color:var(--text-2); padding-left:10px; margin-top:1px;
    word-break:break-word; }
  .route-q-item, .route-r-item { font-family:var(--mono); font-size:10px; color:var(--text-2);
    padding:2.5px 0; display:flex; justify-content:space-between; gap:8px; align-items:center; }
  .route-r-item span:first-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .route-via { font-size:8px; padding:1px 5px; border-radius:3px; flex:0 0 auto; letter-spacing:.04em; }
  .via-proxy { background:rgba(95,168,107,.20); color:#7fc98a; }
  .via-governor-probe { background:rgba(155,110,200,.20); color:#b78fd4; }
  .via-log { background:rgba(110,134,200,.16); color:#9fb0d8; }
  .route-empty { font-size:10px; color:var(--text-3); font-style:italic; }
  /* Task-stream rows are hoverable; the floating detail card shows full per-call info */
  tr[data-task] { cursor: help; }
  tr[data-task]:hover > td { background: rgba(200,169,110,0.06); }
  #taskHover {
    position: fixed; z-index: 9999; width: 340px; max-height: 80vh; overflow:auto;
    background: rgba(18,18,20,0.97); border: 1px solid var(--gold-dim, rgba(200,169,110,0.45));
    border-radius: 8px; padding: 10px 12px; box-shadow: 0 8px 28px rgba(0,0,0,0.55);
    font-family: var(--mono, monospace); font-size: 11px; color: var(--text, #e8e4dc);
    pointer-events: none; backdrop-filter: blur(3px);
  }
  #taskHover .thh { font-size:12px; font-weight:600; margin-bottom:6px; padding-bottom:6px;
    border-bottom:1px solid rgba(200,169,110,0.18); display:flex; justify-content:space-between; gap:8px; }
  #taskHover .thk { color: var(--gold-dim, #c8a96e); font-size:9px; letter-spacing:.08em; }
  #taskHover .thr { display:flex; justify-content:space-between; gap:10px; padding:1.5px 0; }
  #taskHover .thr span { color: rgba(232,228,220,0.55); }
  #taskHover .thr b { color: var(--text, #e8e4dc); font-weight:500; text-align:right; }
  #taskHover .thp { margin-top:7px; padding-top:6px; border-top:1px solid rgba(200,169,110,0.18); }
  #taskHover .thp > span { color: rgba(232,228,220,0.55); display:block; margin-bottom:3px; }
  #taskHover .thp > div { white-space:pre-wrap; word-break:break-word; color:var(--text,#e8e4dc);
    max-height:160px; overflow:auto; }
  #taskHover .thp.muted > div { color: rgba(232,228,220,0.4); font-style:italic; }
  #taskHover .ths { margin-top:7px; font-size:9px; color: rgba(232,228,220,0.4); text-align:right; }
  .tcard .name {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .tcard .state {
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    margin-left: auto;
  }
  .tcard .metrics {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 6px;
  }
  .metric .k {
    font-size: 8.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .metric .v {
    font-family: var(--mono);
    font-size: 15px;
    color: var(--text);
    margin-top: 2px;
  }
  .metric .v.accent { color: var(--gold); }

  .sdot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
  .sdot.up { background: var(--up); box-shadow: 0 0 6px rgba(95,168,107,0.6); }
  .sdot.busy { background: var(--busy); box-shadow: 0 0 6px rgba(200,169,110,0.6); }
  .sdot.cold { background: var(--cold); }

  /* ---- Tables ---- */
  table { width: 100%; border-collapse: collapse; font-family: var(--mono); }
  th {
    font-family: var(--sans);
    font-size: 8.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-3);
    text-align: left;
    font-weight: 600;
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    background: var(--bg);
  }
  td {
    font-size: 11px;
    color: var(--text);
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  td.muted { color: var(--text-2); }
  .tbl-scroll { overflow-y: auto; flex: 1 1 auto; min-height: 0; }

  .pill {
    font-family: var(--sans);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 1px 7px;
    border: 1px solid var(--line-strong);
    color: var(--text-2);
  }
  .pill.done { color: var(--up); border-color: rgba(95,168,107,0.35); }
  .pill.run  { color: var(--gold); border-color: rgba(200,169,110,0.4); }
  .pill.queue { color: var(--text-3); }
  .pill.fail { color: var(--cliff); border-color: rgba(194,85,75,0.4); }

  /* ---- Gantt / swimlane ---- */
  .gantt {
    flex: none;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 8px 10px 6px;
    margin-bottom: 12px;
  }
  .gantt-title {
    font-size: 8.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 7px;
  }
  .lane {
    display: grid;
    grid-template-columns: 78px 1fr;
    align-items: center;
    gap: 8px;
    height: 16px;
    margin-bottom: 3px;
  }
  .lane .ln {
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track { position: relative; height: 9px; background: rgba(255,255,255,0.025); }
  .bar { position: absolute; top: 0; height: 9px; opacity: 0.85; }
  .axis {
    display: flex; justify-content: space-between;
    font-family: var(--mono); font-size: 8px; color: var(--text-3);
    margin-top: 4px; padding-left: 86px;
  }

  /* ---- HUD (bottom 30%) ---- */
  .hud {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr 1.25fr;
    gap: 1px;
    background: var(--line);
    min-height: 0;
  }
  .hud .panel { background: var(--panel-2); }
  .hud-stack {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 10px;
  }
  .mini-label {
    font-size: 8px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 2px;
  }
  .mini-wrap { position: relative; min-height: 0; }

  .legend { display: flex; flex-direction: column; gap: 4px; justify-content: center; }
  .lg-row { display: flex; align-items: center; gap: 7px; font-family: var(--mono); font-size: 10px; }
  .lg-sw { width: 8px; height: 8px; flex: none; }
  .lg-row .gb { margin-left: auto; color: var(--text-2); }
  /* flexbox: the donut takes all remaining space (flex:1, min-width:0), the legend
     its natural width. The canvas is absolute so its intrinsic size can't floor the
     flex item — this is what froze the donut's WIDTH on resize. */
  .pie-flex { display: flex; gap: 12px; flex:1 1 auto; min-height:0; align-items: stretch; }
  .pie-flex > .mini-wrap { flex: 1 1 0; min-width: 0; min-height: 0; position: relative; height: auto; }
  .pie-flex > .mini-wrap > canvas { position: absolute !important; inset: 0; }
  .pie-flex > .legend { flex: 0 0 auto; align-self: center; }

  ::-webkit-scrollbar { width: 7px; height: 7px; }
  ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); }
  ::-webkit-scrollbar-track { background: transparent; }
  /* ---- Gridstack movable-panel workspace ---- */
  .grid-stack { background: var(--line); height: 100vh; width: 100vw; overflow-x: hidden; overflow-y: auto; }
  /* snap resizes instantly so charts read the final container size (no tween) */
  .grid-stack-item, .grid-stack-item-content { transition: none !important; }
  .grid-stack-item-content {
    inset: 0; overflow: hidden; display: flex;
    background: var(--bg); border: 0;
  }
  .grid-stack-item-content > .panel { height: 100%; width: 100%; }

  /* ---- drag grip in each panel header (injected by JS) ---- */
  .phead .grip {
    display: none; align-items: center; gap: 2px; margin-right: 8px;
    color: var(--gold); cursor: move; user-select: none; font-size: 13px; line-height: 1;
  }
  body.layout-edit .phead .grip { display: inline-flex; }

  /* ---- edit mode: make it OBVIOUS panels are movable ---- */
  body.layout-edit .grid-stack-item-content {
    outline: 1.5px dashed rgba(200,169,110,0.55); outline-offset: -1px;
  }
  body.layout-edit .grid-stack-item .phead {
    cursor: move; background: var(--gold-dim);
    border-bottom: 1px solid rgba(200,169,110,0.4);
  }
  body.layout-edit .grid-stack-item:hover .grid-stack-item-content {
    outline-color: var(--gold);
  }
  /* Seam gutters replace per-panel resize handles: drag the BORDER between
     panels to resize. The grid-stack's own resize handles are hidden. */
  .gutter-overlay { position: absolute; inset: 0; pointer-events: none; z-index: 50; }
  .gutter { position: absolute; pointer-events: auto; background: transparent; }
  .gutter-v { width: 12px; transform: translateX(-6px); cursor: col-resize; }
  .gutter-h { height: 12px; transform: translateY(-6px); cursor: row-resize; }
  body.layout-edit .gutter::after {
    content: ''; position: absolute; background: rgba(200,169,110,0.35); border-radius: 2px;
  }
  body.layout-edit .gutter-v::after { left: 5px; top: 12%; width: 2px; height: 76%; }
  body.layout-edit .gutter-h::after { top: 5px; left: 12%; height: 2px; width: 76%; }
  body.layout-edit .gutter:hover::after, .gutter.dragging::after { background: var(--gold); }

  /* old per-panel resize handles — hidden (gutters replace them) */
  .grid-stack-item > .ui-resizable-handle { display: none !important; opacity: 0; }
  .grid-stack-item > .ui-resizable-handle-OFF { opacity: 0; }
  body.layout-edit .grid-stack-item > .ui-resizable-handle { opacity: 1; }
  /* X — left/right vertical strips */
  body.layout-edit .grid-stack-item > .ui-resizable-e,
  body.layout-edit .grid-stack-item > .ui-resizable-w {
    width: 6px; top: 10px; height: calc(100% - 20px);
    background: rgba(200,169,110,0.30); border-radius: 3px;
  }
  body.layout-edit .grid-stack-item > .ui-resizable-e { right: 1px; }
  body.layout-edit .grid-stack-item > .ui-resizable-w { left: 1px; }
  /* Y — top/bottom horizontal strips */
  body.layout-edit .grid-stack-item > .ui-resizable-n,
  body.layout-edit .grid-stack-item > .ui-resizable-s {
    height: 6px; left: 10px; width: calc(100% - 20px);
    background: rgba(200,169,110,0.30); border-radius: 3px;
  }
  body.layout-edit .grid-stack-item > .ui-resizable-n { top: 1px; }
  body.layout-edit .grid-stack-item > .ui-resizable-s { bottom: 1px; }
  /* both — corner squares */
  body.layout-edit .grid-stack-item > .ui-resizable-se,
  body.layout-edit .grid-stack-item > .ui-resizable-sw,
  body.layout-edit .grid-stack-item > .ui-resizable-ne,
  body.layout-edit .grid-stack-item > .ui-resizable-nw {
    width: 10px; height: 10px; background: var(--gold); border-radius: 2px;
  }
  /* brighten on hover so the active edge is obvious */
  body.layout-edit .grid-stack-item > .ui-resizable-handle:hover { background: var(--gold); }
  .grid-stack-placeholder > .placeholder-content {
    background: var(--gold-dim); border: 1.5px dashed rgba(200,169,110,0.6);
  }

  /* edit-mode hint banner */
  .edit-hint {
    display: none; position: fixed; top: 0; left: 0; right: 0; z-index: 998;
    background: var(--gold); color: #131312; text-align: center;
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em;
    text-transform: uppercase; padding: 4px;
  }
  body.layout-edit .edit-hint { display: block; }
  /* layout toolbar */
  .layout-bar {
    position: fixed; bottom: 16px; left: 16px; z-index: 999; display: flex; gap: 6px;
  }
  .layout-bar button {
    background: rgba(14,14,14,0.9); color: var(--gold);
    border: 1px solid rgba(200,169,110,0.35); padding: 5px 12px;
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em;
    cursor: pointer; text-transform: uppercase;
  }
  .layout-bar button.active { background: var(--gold); color: #131312; }
</style>
</head>
<body>
<div class="grid-stack">

    <!-- Panel 1 : Memory -->
    <div class="grid-stack-item" gs-id="memory-panel" gs-x="0" gs-y="0" gs-w="4" gs-h="6"><div class="grid-stack-item-content">
    <section class="panel" data-od-id="memory-panel">
      <div class="phead">
        <span class="ptitle"><span class="dot"></span>Resident Memory</span>
        <span class="big-readout">
          <span class="n">38.4</span><span class="u">GB</span>
          <div class="sub">of 64GB · +2.1 / 5m</div>
        </span>
      </div>
      <div class="pbody">
        <div class="chart-wrap"><canvas id="memChart"></canvas></div>
      </div>
    </section></div></div>

    <!-- Panel 2 : Tenants -->
    <div class="grid-stack-item" gs-id="tenants-panel" gs-x="4" gs-y="0" gs-w="4" gs-h="6"><div class="grid-stack-item-content">
    <section class="panel" data-od-id="tenants-panel">
      <div class="phead">
        <span class="ptitle"><span class="dot"></span>Tenants / Sidecars</span>
        <span class="big-readout"><span class="n" style="font-size:22px">5</span><span class="u">loaded</span></span>
      </div>
      <div class="pbody">
        <div class="tenant-grid" id="tenantGrid">
          <!-- populated dynamically from governor /pressure -->
        </div>
      </div>
    </section></div></div>

    <!-- Panel 3 : Task time-series -->
    <div class="grid-stack-item" gs-id="tasks-panel" gs-x="8" gs-y="0" gs-w="4" gs-h="6"><div class="grid-stack-item-content">
    <section class="panel" data-od-id="tasks-panel">
      <div class="phead">
        <span class="ptitle"><span class="dot"></span>Task Stream</span>
        <span class="big-readout"><span class="n" style="font-size:22px">14</span><span class="u">/hr</span></span>
      </div>
      <div class="pbody">
        <div class="gantt" data-od-id="task-gantt">
          <div class="gantt-title">Activity — last 60 min</div>
          <div id="lanes"></div>
          <div class="axis"><span>-60m</span><span>-45m</span><span>-30m</span><span>-15m</span><span>now</span></div>
        </div>
        <div class="tbl-scroll">
          <table>
            <thead><tr><th>Task</th><th>Start</th><th>Dur</th><th>Status</th></tr></thead>
            <tbody id="taskRows"></tbody>
          </table>
        </div>
      </div>
    </section></div></div>

    <!-- HUD left : Pie -->
    <div class="grid-stack-item" gs-id="hud-pie" gs-x="0" gs-y="6" gs-w="4" gs-h="6"><div class="grid-stack-item-content">
    <section class="panel" data-od-id="hud-pie">
      <div class="phead"><span class="ptitle"><span class="dot"></span>Loaded Now · 64GB</span></div>
      <div class="pbody">
        <div class="pie-flex">
          <div class="mini-wrap" style="height:100%"><canvas id="pieChart"></canvas></div>
          <div class="legend" id="pieLegend"></div>
        </div>
      </div>
    </section></div></div>

    <!-- HUD center : stacked line graphs -->
    <div class="grid-stack-item" gs-id="hud-lines" gs-x="4" gs-y="6" gs-w="4" gs-h="6"><div class="grid-stack-item-content">
    <section class="panel" data-od-id="hud-lines">
      <div class="phead"><span class="ptitle"><span class="dot"></span>Inference Latency · last 20 req</span></div>
      <div class="pbody">
        <div class="hud-stack">
          <div style="display:flex;flex-direction:column;min-height:0">
            <div class="mini-label">Time to First Token (ms) · warn 800</div>
            <div class="mini-wrap" style="flex:1 1 auto"><canvas id="ttftChart"></canvas></div>
          </div>
          <div style="display:flex;flex-direction:column;min-height:0">
            <div class="mini-label">Generation (tokens/sec) · warn 30</div>
            <div class="mini-wrap" style="flex:1 1 auto"><canvas id="tpsChart"></canvas></div>
          </div>
        </div>
      </div>
    </section></div></div>

    <!-- HUD right : status table -->
    <div class="grid-stack-item" gs-id="hud-status" gs-x="8" gs-y="6" gs-w="4" gs-h="6"><div class="grid-stack-item-content">
    <section class="panel" data-od-id="hud-status">
      <div class="phead"><span class="ptitle"><span class="dot"></span>Sidecar Status</span></div>
      <div class="pbody" style="padding-top:0;gap:0;display:flex;flex-direction:column">
        <div class="tbl-scroll" style="flex:0 0 auto;max-height:40%">
          <table>
            <thead><tr><th>Sidecar</th><th></th><th>Since</th><th>TTFT</th><th>Tok total</th></tr></thead>
            <tbody id="sidecarRows"><!-- populated from governor --></tbody>
          </table>
        </div>
        <div style="flex:0 0 auto;padding:6px 8px 2px;font-size:8.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--text-3);border-top:1px solid var(--line);margin-top:4px">Top Memory</div>
        <div class="tbl-scroll" style="flex:1 1 auto">
          <table>
            <thead><tr><th>Process</th><th>RSS</th><th>PID</th></tr></thead>
            <tbody id="topProcessRows"><!-- populated from ps --></tbody>
          </table>
        </div>
      </div>
    </section></div></div>

    <!-- Routing control tower : LLM admission gate (budget / backends / queue / routing) -->
    <div class="grid-stack-item" gs-id="routing-panel" gs-x="0" gs-y="12" gs-w="12" gs-h="5"><div class="grid-stack-item-content">
    <section class="panel" data-od-id="routing-panel">
      <div class="phead">
        <span class="ptitle"><span class="dot"></span>Routing · LLM Admission Gate</span>
        <span class="big-readout"><span class="n" id="routeCommitted" style="font-size:22px">—</span><span class="u">GB held</span></span>
      </div>
      <div class="pbody">
        <div id="routeBudgetBar" class="route-bar"><span style="width:100%;background:#2b2b26;color:#9A958A">governor unreachable</span></div>
        <div class="route-grid">
          <div class="route-col"><div class="route-h">Backends · loaded / leased</div><div id="routeBackends"><div class="route-empty">…</div></div></div>
          <div class="route-col"><div class="route-h">Queue (waiting for memory)</div><div id="routeQueue"><div class="route-empty">…</div></div></div>
          <div class="route-col route-col-wide"><div class="route-h">Recent routing</div><div class="tbl-scroll" style="flex:1"><div id="routeRecent"></div></div></div>
        </div>
      </div>
    </section></div></div>

</div>

<script>
const GOLD = "#C8A96E", TEXT3 = "#63605A", TEXT2 = "#9A958A", GRID = "rgba(255,255,255,0.05)";
const mono = '"SF Mono", ui-monospace, Menlo, monospace';

Chart.defaults.font.family = mono;
Chart.defaults.font.size = 9;
Chart.defaults.color = TEXT3;
Chart.defaults.animation = { duration: 600 };

// ---------- Memory area chart — starts empty, filled by live poll ----------
const memN = 60;
const memData = new Array(memN).fill(null);  // null = no data yet
const memLabels = memData.map((_,i) => i);

function thresholdLine(val, color, dash){
  return { type:'line', borderColor:color, borderWidth:1, borderDash:dash||[4,4],
    data: new Array(memN).fill(val), pointRadius:0, fill:false, tension:0 };
}

new Chart(document.getElementById('memChart'), {
  type:'line',
  data:{ labels: memLabels, datasets:[
    { data: memData, borderColor: GOLD, borderWidth: 1.5, pointRadius: 0, tension: 0.3,
      fill: true, backgroundColor: 'rgba(200,169,110,0.12)' },
    { ...thresholdLine(45, '#C99A52', [5,4]) },
    { ...thresholdLine(55, '#C2554B', [5,4]) },
  ]},
  options:{ maintainAspectRatio:false, responsive:true,
    plugins:{ legend:{display:false}, tooltip:{enabled:true,
      callbacks:{ title:()=>'', label:(c)=> c.datasetIndex===0 ? c.parsed.y+' GB' : null } } },
    scales:{ x:{ display:false, grid:{display:false} },
      // max covers the full ~69GB machine (was 60 → clipped memory above 60GB flat at the
      // top, right at the cliff where it matters most). 72 matches the HUD sparkline.
      y:{ min:14, max:72, grid:{color:GRID}, ticks:{ stepSize:10, callback:v=>v+'G' } } } }
});

// ---------- Pie : starts empty, filled by live poll ----------
new Chart(document.getElementById('pieChart'), {
  type:'doughnut',
  data:{ labels: ['loading…'], datasets:[{ data: [64], backgroundColor: ['#1a1a18'], borderColor:'#0E0E0E', borderWidth:2 }] },
  options:{ maintainAspectRatio:false, responsive:true, cutout:'58%',
    plugins:{ legend:{display:false}, tooltip:{ callbacks:{ label:c=>c.label+' '+c.parsed+'GB' } } } }
});
document.getElementById('pieLegend').innerHTML = '<div class="lg-row" style="color:var(--text-3)">waiting for data…</div>';

// ---------- TTFT + tokens/sec line graphs — start empty ----------
function miniLine(id, data, warn, max){
  new Chart(document.getElementById(id), {
    type:'line',
    data:{ labels: data.map((_,i)=>i+1), datasets:[
      { data, borderColor: GOLD, borderWidth:1.4, pointRadius:0, tension:0.25,
        fill:true, backgroundColor:'rgba(200,169,110,0.10)' },
      { data:new Array(Math.max(data.length,10)).fill(warn), borderColor:'#C99A52', borderWidth:1,
        borderDash:[4,3], pointRadius:0, fill:false } ]},
    options:{ maintainAspectRatio:false, responsive:true,
      plugins:{ legend:{display:false}, tooltip:{ callbacks:{ title:()=>'', label:c=>c.datasetIndex===0?c.parsed.y:null } } },
      scales:{ x:{ display:false, grid:{display:false} },
        y:{ min:0, max, grid:{color:GRID}, ticks:{ maxTicksLimit:3 } } } }
  });
}
miniLine('ttftChart', [], 800, 120000);   // inference latency: default 0–120s until data arrives
miniLine('tpsChart', [], 30, 75);

// Adaptive y-axis: scale to the live data so a single slow request (e.g. a 120s
// spike) doesn't flatten everything into the floor — while keeping the warn line
// in view and a sane minimum range when values are tiny. Reads warn from dataset[1].
// headroom: axis-max = peak × headroom (2.0 → peak sits ~50% down from the top).
// emptyMax: the default ceiling to show when there's no data yet (e.g. 120000ms = 120s).
function fitY(chart, headroom = 1.2, emptyMax = null){
  const warn = Number(chart.data.datasets[1]?.data?.[0]) || 0;
  const vals = chart.data.datasets[0].data.filter(v => v != null && isFinite(v));
  if (!vals.length) {                                          // no data → default ceiling
    if (emptyMax != null) chart.options.scales.y.max = emptyMax;
    return;
  }
  const peak = Math.max(warn, ...vals);
  const padded = peak * headroom;
  const mag = Math.pow(10, Math.floor(Math.log10(padded || 1)));
  const nice = Math.ceil(padded / mag) * mag;                  // round up to clean ticks
  chart.options.scales.y.max = Math.max(nice, warn * 1.25, 1); // keep warn visible
}

// ---------- Gantt swimlane — starts empty, built from real log metrics ----------
document.getElementById('lanes').innerHTML =
  '<div style="color:var(--text-3);font-size:9px;letter-spacing:.12em;text-transform:uppercase;padding:4px 0">waiting for activity data…</div>';

// Called by refreshAll to rebuild lanes from real model_call + synth events
function updateGantt(logMetrics, telemetry) {
  const now = Date.now();
  const WINDOW = 60 * 60 * 1000; // 60 min in ms

  // Collect events with timestamps
  const events = [];
  (logMetrics ?? []).filter(m => m.metric === 'model_call').forEach(m => {
    events.push({ name: m.label ?? 'ollama', start: m.ts - (m.value ?? 0), dur: m.value ?? 0, c: '#6E86C8' });
  });
  (telemetry?.recent_synths ?? []).forEach(s => {
    const ts = (s.ts ?? 0) * 1000;
    const dur = (s.seconds ?? 0) * 1000;
    events.push({ name: s.engine ?? 'tts', start: ts - dur, dur, c: '#C8A96E' });
  });

  if (!events.length) {
    document.getElementById('lanes').innerHTML =
      '<div style="color:var(--text-3);font-size:9px;letter-spacing:.12em;text-transform:uppercase;padding:4px 0">no activity in last 60 min</div>';
    return;
  }

  // Group by name, filter to last 60 min
  const byName = {};
  events.forEach(e => {
    if (e.start < now - WINDOW) return;
    if (!byName[e.name]) byName[e.name] = { c: e.c, bars: [] };
    const left = ((e.start - (now - WINDOW)) / WINDOW * 100).toFixed(1);
    const width = Math.max(0.5, (e.dur / WINDOW * 100)).toFixed(1);
    byName[e.name].bars.push({ left, width });
  });

  const html = Object.entries(byName).map(([name, {c, bars}]) => {
    const barHtml = bars.map(b =>
      `<span class="bar" style="left:${b.left}%;width:${b.width}%;background:${c}"></span>`
    ).join('');
    return `<div class="lane"><span class="ln">${name}</span><span class="track">${barHtml}</span></div>`;
  }).join('');

  document.getElementById('lanes').innerHTML = html || '<div style="color:var(--text-3);font-size:9px;letter-spacing:.12em;padding:4px 0">no activity in window</div>';
}

// Task table starts empty — populated by refreshAll from real log metrics
document.getElementById('taskRows').innerHTML =
  '<tr><td colspan="4" style="color:var(--text-3);text-align:center;padding:12px">waiting for activity…</td></tr>';

// ---- Live data bridge ----
// Tauri 2 invoke paths (in order of preference):
//   window.__TAURI__.core.invoke  (withGlobalTauri:true, Tauri 2)
//   window.__TAURI_INTERNALS__.invoke  (always available, Tauri 2)
async function tauriGet(cmd) {
  try {
    if (typeof window.__TAURI__?.core?.invoke === 'function')
      return await window.__TAURI__.core.invoke(cmd);
    if (typeof window.__TAURI_INTERNALS__?.invoke === 'function')
      return await window.__TAURI_INTERNALS__.invoke(cmd);
  } catch(e) { console.warn('invoke failed:', cmd, e?.message); }
  return null;  // browser mode — caller will use mock data
}

const memRing = [...memData]; // rolling 60-sample buffer

// Historical tracking for sidecar "since" + cumulative tokens
const sidecarHistory = {};

function updateSidecarTable(tenants) {
  const now = new Date();
  const rows = document.getElementById('sidecarRows');
  if (!rows) return;
  tenants.forEach(t => {
    if (!sidecarHistory[t.name]) {
      sidecarHistory[t.name] = { since: now, totalTokens: 0, lastTtft: null };
    }
    const h = sidecarHistory[t.name];
    if (t.state !== 'cold' && !h.sinceActive) h.sinceActive = now;
  });
  rows.innerHTML = tenants.map(t => {
    const h = sidecarHistory[t.name] || {};
    const sinceStr = h.sinceActive ? h.sinceActive.toTimeString().slice(0,5) : '—';
    const dotClass = t.state === 'busy' ? 'busy' : t.state === 'idle' || t.state === 'running' ? 'up' : 'cold';
    const ttft = h.lastTtft ? `${h.lastTtft}ms` : '—';
    const tok = h.totalTokens > 0 ? (h.totalTokens/1e6).toFixed(2)+'M' : '—';
    return `<tr>
      <td>${t.name}</td>
      <td><span class="sdot ${dotClass}"></span></td>
      <td class="muted">${sinceStr}</td>
      <td>${ttft}</td>
      <td>${tok}</td>
    </tr>`;
  }).join('');
}

// Track telemetry into sidecar history
function absorbTelemetry(telemetry) {
  if (!telemetry) return;
  (telemetry.recent_calls || []).forEach(c => {
    const h = sidecarHistory[c.engine];
    if (h) {
      h.totalTokens += c.output_tokens || 0;
      if (c.latency_s) h.lastTtft = Math.round(c.latency_s * 1000);
    }
  });
  (telemetry.recent_synths || []).forEach(s => {
    const h = sidecarHistory[s.engine];
    if (h) h.totalTokens += s.chars || 0;
  });
}

// Known loaded memory footprint per sidecar (when warm/busy — from model sizes)
const SIDECAR_MEM = { omnivoice: 12.0, kokoro: 4.0, dia: 8.0, whisper: 2.0, llamacpp: 8.0, fastmlx: 8.0, mlxlm: 8.0, comfyui: 12.0 };

// Routing control tower — admission-gate budget + per-backend load + queue + routing.
// Fetches the governor's /budget directly (CSP is null). Degrades gracefully: if /budget
// is unreachable, backends still render from /pressure and routing from /telemetry.
const GOVERNOR_URL = 'http://127.0.0.1:8799';
async function renderRouting(pressure, telemetry) {
  let budget = null;
  try {
    const r = await fetch(`${GOVERNOR_URL}/budget`, { signal: AbortSignal.timeout(2500) });
    if (r.ok) budget = await r.json();
  } catch (e) { /* governor down → partial render below */ }

  const shortModel = m => String(m || '?').split('/').pop();

  // --- budget bar ---
  const bar = document.getElementById('routeBudgetBar');
  const committedEl = document.getElementById('routeCommitted');
  if (bar) {
    if (budget) {
      const B = budget.budget_gb || 52, used = budget.committed_gb || 0;
      const freeBud = Math.max(0, B - used);
      const pct = x => Math.max(0, Math.min(100, (x / B) * 100));
      if (committedEl) committedEl.textContent = used.toFixed(0);
      const liveFree = budget.live_free_gb != null ? ` · ${budget.live_free_gb}G real free` : '';
      bar.innerHTML =
        `<span style="width:${pct(used)}%;background:#C8A96E;color:#0E0E0E">${used.toFixed(0)}G committed</span>` +
        `<span style="width:${pct(freeBud)}%;background:#2b2b26;color:#9A958A">${freeBud.toFixed(0)}G of ${B}G budget${liveFree}</span>`;
    } else {
      bar.innerHTML = `<span style="width:100%;background:#3a2b2b;color:#c89a9a">governor /budget unreachable</span>`;
      if (committedEl) committedEl.textContent = '—';
    }
  }

  // --- backends: loaded models (from /pressure) + active leases (from /budget) ---
  const beEl = document.getElementById('routeBackends');
  if (beEl) {
    const leases = budget?.active_leases || [];
    const ollamaLoaded = (pressure?.tenants || [])
      .filter(t => t.tenant === 'ollama' && (t.mem_gb || 0) > 0)
      .map(t => `${t.name} (${(t.mem_gb).toFixed(0)}G)`);
    beEl.innerHTML = ['ollama', 'mlxlm', 'llamacpp'].map(be => {
      const bl = leases.filter(l => l.backend === be);
      const leaseModels = bl.map(l => `${shortModel(l.model)} (${l.est_gb}G lease)`);
      const loaded = be === 'ollama' ? ollamaLoaded : [];
      const all = [...new Set([...loaded, ...leaseModels])];
      return `<div class="route-be"><div class="route-be-name"><span>${be}</span>` +
        `<span class="lease-n">${bl.length || 0} lease${bl.length === 1 ? '' : 's'}</span></div>` +
        `<div class="route-be-models">${all.length ? all.join(', ') : '<span class="route-empty">idle</span>'}</div></div>`;
    }).join('');
  }

  // --- queue ---
  const qEl = document.getElementById('routeQueue');
  if (qEl) {
    const q = budget?.queue || [];
    qEl.innerHTML = q.length
      ? q.map(it => `<div class="route-q-item"><span>#${it.position} ${shortModel(it.model)} → ${it.backend}</span>` +
          `<span>${it.est_gb}G · ${(it.wait_s || 0).toFixed(0)}s</span></div>`).join('')
      : '<div class="route-empty">no jobs queued — everything fits</div>';
  }

  // --- recent routing (from telemetry: model → backend, tagged by capture source) ---
  const rEl = document.getElementById('routeRecent');
  if (rEl) {
    const calls = (telemetry?.recent_calls || []).slice(-14).reverse();
    rEl.innerHTML = calls.length ? calls.map(c => {
      const via = (c.via || 'log').replace(/[^a-z-]/gi, '');
      const be = c.backend || 'ollama';
      return `<div class="route-r-item"><span>${shortModel(c.model)} → ${be}</span>` +
        `<span class="route-via via-${via}">${c.via || 'log'}</span></div>`;
    }).join('') : '<div class="route-empty">no recent calls</div>';
  }
}

async function refreshAll() {
  const [pressure, telemetry, sidecars, stats, logMetrics] = await Promise.all([
    tauriGet('get_pressure'),
    tauriGet('get_telemetry'),
    tauriGet('get_sidecars'),
    tauriGet('get_predictor_stats'),
    tauriGet('get_log_metrics'),
  ]);
  // Cache for HUD iframe postMessage
  if (pressure)    _pollCache.get_pressure = pressure;
  if (telemetry)   _pollCache.get_telemetry = telemetry;
  if (sidecars)    _pollCache.get_sidecars = sidecars;
  if (logMetrics)  _pollCache.get_log_metrics = logMetrics;
  // Push to embedded HUD if open
  const hud = document.getElementById('hudIframe');
  if (hud?.contentWindow) hud.contentWindow.postMessage({
    type: 'atelier-data', pressure, telemetry, sidecars, logMetrics
  }, '*');

  // -- Memory chart --
  if (pressure) {
    const gb = pressure.resident_gb ?? 38.4;
    memRing.push(+gb.toFixed(1));
    if (memRing.length > 60) memRing.shift();
    const mc = Chart.getChart('memChart');
    if (mc) { mc.data.datasets[0].data = [...memRing]; mc.data.labels = memRing.map((_,i)=>i); mc.update('none'); }
    const nr = document.querySelector('.big-readout .n');
    if (nr) nr.textContent = gb.toFixed(1);
    document.title = `${gb.toFixed(1)} GB · ${pressure.level ?? ''}`;
  }

  // -- Build unified tenant list: governor tenants + Ollama always shown --
  const govTenants = pressure?.tenants ?? [];

  // Enrich atelier sidecars with known mem footprint when warm/busy
  let enriched = govTenants.map(t => ({
    ...t,
    mem_gb: t.mem_gb ?? (t.state !== 'cold' ? (SIDECAR_MEM[t.name] ?? 0) : 0),
  }));

  // Add Ollama from /api/ps (always, even when empty)
  // Ollama models already come from the governor's /pressure tenants (in `enriched`).
  // The dashboard no longer polls /api/ps itself — that flooded the ollama log and
  // doubled the models. Show a cold slot only if the governor reports none loaded.
  if (!enriched.some(t => t.tenant === 'ollama')) {
    enriched.push({
      tenant: 'ollama', name: 'ollama', state: 'cold',
      active_jobs: 0, queue_depth: 0, mem_gb: 0,
      subtitle: 'no model loaded',
    });
  }

  // Dedupe by name: the governor's /pressure tenants AND the /api/ps fetch can
  // both list the same Ollama model, which doubled it in the donut + tenant grid.
  // Keep the richer entry (the one that actually reports memory).
  {
    const byName = new Map();
    for (const t of enriched) {
      const ex = byName.get(t.name);
      if (!ex || (t.mem_gb || 0) > (ex.mem_gb || 0)) byName.set(t.name, { ...ex, ...t });
    }
    enriched = [...byName.values()];
  }

  // -- Tenant cards (fully dynamic) --
  const grid = document.getElementById('tenantGrid');
  const countEl = document.querySelector('[data-od-id="tenants-panel"] .big-readout .n');
  if (countEl) countEl.textContent = enriched.filter(t => t.state !== 'cold').length;
  if (grid) {
    grid.innerHTML = enriched.map(t => {
      const dotClass = t.state === 'busy' ? 'busy' : t.state === 'idle' || t.state === 'running' || t.state === 'warm' ? 'up' : 'cold';
      const stateLabel = t.state === 'idle' || t.state === 'warm' ? 'up' : t.state;
      const isBusy = t.state === 'busy';
      const sub = t.subtitle ? `<div style="font-size:9px;color:var(--text-3);margin-top:2px">${t.subtitle}</div>` : '';
      return `<div class="tcard${isBusy ? ' busy' : ''}">
        <div class="name"><span class="sdot ${dotClass}"></span>${t.name}<span class="state">${stateLabel}</span></div>
        ${sub}
        <div class="metrics">
          <div class="metric"><div class="k">jobs</div><div class="v${isBusy ? ' accent' : ''}">${t.active_jobs ?? 0}</div></div>
          <div class="metric"><div class="k">queue</div><div class="v">${t.queue_depth ?? 0}</div></div>
          <div class="metric"><div class="k">mem</div><div class="v">${(t.mem_gb ?? 0).toFixed(1)}</div></div>
        </div>
      </div>`;
    }).join('');
  }
  updateSidecarTable(enriched);

  // -- Pie chart (loaded now): honest memory breakdown --
  // Atelier tenants + a labeled "system / other" wedge for REAL-but-untracked memory
  // (OS, other apps, the dashboard, MLX caches) + ACTUAL free. Previously the donut
  // charted only tenants and called everything else "free", so ~20GB of real usage
  // hid inside an overstated "free" wedge with no identifier. Always redraws (even with
  // nothing loaded) so it can't go stale and leave a phantom segment painted on.
  const loaded = enriched.filter(t => t.mem_gb > 0);
  const pc = Chart.getChart('pieChart');
  const PALETTE = ['#C8A96E','#6E86C8','#A98B5C','#5FA86B','#C99A52','#9B6EC8','#D9C091','#63A0A8'];
  const FREE_COLOR = '#26251F';
  const OTHER_COLOR = '#454751';   // slate grey — deliberately NOT a tenant colour
  if (pc) {
    const residentGb = pressure?.resident_gb ?? 0;
    const freeGb = Math.max(0, pressure?.free_gb ?? 0);
    const tenantSum = loaded.reduce((a,t)=>a+(t.mem_gb||0),0);
    // Real usage not attributable to any Atelier tenant. Floor at 0 (estimates can drift).
    const other = Math.max(0, residentGb - tenantSum);
    const segs = loaded.map((t,i) => ({ name: t.name, gb: t.mem_gb, c: PALETTE[i % PALETTE.length] }));
    if (other > 0.3) segs.push({ name: 'system / other', gb: other, c: OTHER_COLOR });
    segs.push({ name: 'free', gb: freeGb, c: FREE_COLOR });
    pc.data.datasets[0].data = segs.map(s => +(s.gb||0).toFixed(1));
    pc.data.labels = segs.map(s => s.name);
    pc.data.datasets[0].backgroundColor = segs.map(s => s.c);
    pc.update('none');
    const legendEl = document.getElementById('pieLegend');
    if (legendEl) legendEl.innerHTML = segs.map(r =>
      `<div class="lg-row"><span class="lg-sw" style="background:${r.c}"></span>${r.name}<span class="gb">${(r.gb??0).toFixed(0)}GB</span></div>`).join('');
  }

  // -- Routing control tower --
  renderRouting(pressure, telemetry);

  // -- Telemetry --
  absorbTelemetry(telemetry);

  // -- Call latency chart: total_duration from log (ms) — best proxy for TTFT we have from logs --
  const ttftChart = Chart.getChart('ttftChart');
  const callLatencies = (logMetrics ?? [])
    .filter(m => m.source === 'ollama' && m.metric === 'model_call' && m.value > 0)
    .slice(-20).map(m => +m.value.toFixed(0));
  if (ttftChart) {
    ttftChart.data.datasets[0].data = callLatencies;
    ttftChart.data.labels = callLatencies.map((_,i)=>i+1);
    ttftChart.data.datasets[1].data = new Array(Math.max(callLatencies.length,1)).fill(800);
    fitY(ttftChart, 2.0, 120000);   // peak ~50% down from top; 120s default when empty
    ttftChart.update('none');
  }

  // -- tps sparkline: ollama_perf live → log metrics → predictor avg_rate --
  const tpsChart = Chart.getChart('tpsChart');
  const ttftChart2 = Chart.getChart('ttftChart');

  // Best source: governor's ollama_perf (real eval_count/eval_duration from response body)
  const perf = telemetry?.ollama_perf;
  if (perf?.tok_s && tpsChart) {
    // Push into a rolling buffer stored on the chart
    if (!tpsChart._atelierRing) tpsChart._atelierRing = [];
    tpsChart._atelierRing.push(perf.tok_s);
    if (tpsChart._atelierRing.length > 20) tpsChart._atelierRing.shift();
    tpsChart.data.datasets[0].data = [...tpsChart._atelierRing];
    tpsChart.data.labels = tpsChart._atelierRing.map((_,i)=>i+1);
    tpsChart.data.datasets[1].data = new Array(tpsChart._atelierRing.length).fill(30);
    fitY(tpsChart);
    tpsChart.update('none');
  }
  if (perf?.ttft_ms && ttftChart2) {
    if (!ttftChart2._atelierRing) ttftChart2._atelierRing = [];
    ttftChart2._atelierRing.push(perf.ttft_ms);
    if (ttftChart2._atelierRing.length > 20) ttftChart2._atelierRing.shift();
    ttftChart2.data.datasets[0].data = [...ttftChart2._atelierRing];
    ttftChart2.data.labels = ttftChart2._atelierRing.map((_,i)=>i+1);
    ttftChart2.data.datasets[1].data = new Array(ttftChart2._atelierRing.length).fill(800);
    fitY(ttftChart2, 2.0, 120000);   // match the latency chart: peak ~50% down, 120s empty default
    ttftChart2.update('none');
  }

  // Fallback: log metrics (tokens_per_sec parsed from Ollama log)
  if (!perf?.tok_s) {
    const tpsFromLog = (logMetrics ?? []).filter(m => m.source === 'ollama' && m.metric === 'tokens_per_sec').slice(-20).map(m => m.value);
    if (tpsChart && tpsFromLog.length) {
      tpsChart.data.datasets[0].data = tpsFromLog;
      tpsChart.data.labels = tpsFromLog.map((_,i)=>i+1);
      tpsChart.data.datasets[1].data = new Array(tpsFromLog.length).fill(30);
      tpsChart.update('none');
    } else if (tpsChart && stats?.stats?.length) {
      // Last resort: predictor historical avg_rate
      const llmStats = stats.stats.filter(s => s.kind === 'llm' && s.avg_rate > 1);
      if (llmStats.length) {
        const rates = llmStats.map(s => s.avg_rate);
        tpsChart.data.datasets[0].data = rates;
        tpsChart.data.labels = llmStats.map(s => s.model.split(':')[0]);
        tpsChart.data.datasets[1].data = new Array(rates.length).fill(30);
        tpsChart.update('none');
      }
    }
  }

  // -- Gantt: real events only --
  updateGantt(logMetrics, telemetry);

  // -- Top processes (polled every 5th refresh ~ 12.5s) --
  if (!refreshAll._procTick) refreshAll._procTick = 0;
  if (refreshAll._procTick++ % 5 === 0) {
    // Highest-MEMORY processes from the governor (sorted by RSS desc) — fall back to the
    // Tauri command (CPU-sorted) only if the governor is unreachable.
    const renderProcs = procs => {
      const tbody = document.getElementById('topProcessRows');
      if (!tbody || !procs?.length) return;
      tbody.innerHTML = [...procs].sort((a,b)=>(b.rss_mb||0)-(a.rss_mb||0)).map(p =>
        `<tr><td style="max-width:140px;overflow:hidden;text-overflow:ellipsis">${p.name}</td><td>${p.rss_mb} MB</td><td class="muted">${p.pid}</td></tr>`
      ).join('');
    };
    fetch(`${GOVERNOR_URL}/top-processes?limit=10`, { signal: AbortSignal.timeout(2500) })
      .then(r => r.json()).then(d => renderProcs(d.processes))
      .catch(() => tauriGet('get_top_processes').then(d => renderProcs(d?.processes)));
  }

  // -- Task stream: model_call log metrics + synths --
  // Each row carries a `meta` object → the hover card renders whatever fields exist.
  // Prompt + in/out tokens populate once the capturing proxy (Phase 6) feeds /telemetry.
  const modelCallRows = (logMetrics ?? []).filter(m => m.source==='ollama' && m.metric==='model_call')
    .slice(-8).map(c => ({
      name: `${c.label ?? 'ollama'} · ${(c.path??'/api/chat').replace('/api/','')}`,
      ts: c.ts, st: c.status===200 ? 'done' : c.status===500 ? 'fail' : 'run',
      dur: c.value > 60000 ? (c.value/60000).toFixed(1)+'m' : c.value > 1000 ? (c.value/1000).toFixed(1)+'s' : Math.round(c.value)+'ms',
      meta: { kind:'LLM', backend:'ollama', model:c.label, path:c.path, status:c.status, source:'log tail' },
    }));
  const synthRows = (telemetry?.recent_synths ?? []).map(s => ({
    name: `tts · ${s.engine} · ${s.chars ?? 0}ch`,
    ts: (s.ts ?? 0) * 1000, st: 'done',
    dur: s.seconds ? s.seconds.toFixed(1)+'s' : '—',
    meta: { kind:'TTS', backend:s.engine, chars:s.chars, seconds:s.seconds, text:s.text, source:'sidecar log' },
  }));
  // Second source for Ollama calls: the governor's recent_calls (durable, survives
  // restarts via its history file). Deduped against the dashboard's own log metrics.
  const govCallRows = (telemetry?.recent_calls ?? []).map(c => ({
    name: `${c.model ?? 'ollama'} · ${(c.path ?? '/api/chat').replace('/api/','')}`,
    ts: (c.ts ?? 0) * 1000,
    st: c.status === '200' ? 'done' : c.status === '500' ? 'fail' : 'run',
    dur: (typeof c.latency === 'string' ? c.latency.replace(/(\.\d{2})\d+/, '$1') : '—'),
    meta: { kind:'LLM', backend:c.backend ?? 'ollama', model:c.model, path:c.path, status:c.status,
            latency:c.latency, tok_s:c.tok_s, ttft_ms:c.ttft_ms, eval_tokens:c.eval_tokens ?? c.out_tok,
            in_tok:c.in_tok ?? c.prompt_tokens, num_ctx:c.num_ctx, est_gb:c.est_gb, prompt:c.prompt, source:'governor' },
  }));
  const _seen = new Set();
  const allRows = [...modelCallRows, ...govCallRows, ...synthRows]
    .filter(r => { const k = Math.round(r.ts/1000) + ':' + r.name.split(' · ')[0];
                   if (_seen.has(k)) return false; _seen.add(k); return true; })
    .sort((a,b)=>b.ts-a.ts).slice(0,11);
  const tbody = document.getElementById('taskRows');
  window._taskMeta = allRows.map(r => ({ ...r.meta, name:r.name, dur:r.dur, st:r.st, ts:r.ts }));
  if (tbody && allRows.length) tbody.innerHTML = allRows.map((r,i) => {
    const t = new Date(r.ts); const tstr = t.toTimeString().slice(0,8);
    return `<tr data-task="${i}"><td>${r.name}</td><td class="muted">${tstr}</td><td>${r.dur}</td><td><span class="pill ${r.st}">${r.st}</span></td></tr>`;
  }).join('');
}

// ---- Task hover card: full per-call detail (prompt + tokens land with the proxy) ----
function _fmtTaskHover(m){
  const esc = s => String(s).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  const row = (k,v) => (v===undefined||v===null||v==='') ? '' : `<div class="thr"><span>${k}</span><b>${esc(v)}</b></div>`;
  const stamp = m.ts ? new Date(m.ts).toTimeString().slice(0,8) : '';
  let h = `<div class="thh">${esc(m.name||'task')}<span class="thk">${esc(m.kind||'')}</span></div>`;
  h += row('backend', m.backend) + row('model', m.model) + row('path', m.path);
  h += row('status', m.status) + row('started', stamp) + row('duration', m.dur);
  if (m.tok_s)       h += row('tok/s', (+m.tok_s).toFixed(1));
  if (m.ttft_ms)     h += row('time-to-first-token', m.ttft_ms+' ms');
  if (m.in_tok)      h += row('input tokens', m.in_tok);
  if (m.eval_tokens) h += row('output tokens', m.eval_tokens);
  if (m.num_ctx)     h += row('context window', m.num_ctx + ' (auto-sized)');
  if (m.est_gb)      h += row('memory reserved', m.est_gb + ' GB');
  if (m.chars)       h += row('chars', m.chars);
  if (m.seconds)     h += row('audio seconds', (+m.seconds).toFixed(1));
  const promptText = m.prompt || m.text;
  if (promptText) h += `<div class="thp"><span>prompt</span><div>${esc(String(promptText).slice(0,600))}</div></div>`;
  else if (m.kind==='LLM') h += `<div class="thp muted"><span>prompt</span><div>— not captured (enable the capturing proxy to record prompts &amp; in/out tokens)</div></div>`;
  h += `<div class="ths">source: ${esc(m.source||'?')}</div>`;
  return h;
}
(function _wireTaskHover(){
  const card = document.createElement('div'); card.id='taskHover'; card.style.display='none';
  document.body.appendChild(card);
  document.addEventListener('mouseover', e => {
    const tr = e.target.closest && e.target.closest('tr[data-task]'); if(!tr) return;
    const m = (window._taskMeta||[])[+tr.dataset.task]; if(!m) return;
    card.innerHTML = _fmtTaskHover(m); card.style.display='block';
    const r = tr.getBoundingClientRect();
    const top = Math.min(r.top, window.innerHeight - card.offsetHeight - 12);
    card.style.top = Math.max(8, top) + 'px';
    card.style.left = Math.max(8, r.left - card.offsetWidth - 12) + 'px';
  });
  document.addEventListener('mouseout', e => {
    const tr = e.target.closest && e.target.closest('tr[data-task]');
    if (tr && !tr.contains(e.relatedTarget)) card.style.display='none';
  });
})();

// After each poll, push data to the embedded HUD iframe (so it doesn't double-poll)
const _origRefresh = refreshAll;
let _lastPollData = {};
async function refreshAllAndSync() {
  await _origRefresh();
  const hudFrame = document.getElementById('hudIframe');
  if (hudFrame?.contentWindow) {
    hudFrame.contentWindow.postMessage({ type: 'atelier-data', ..._lastPollData }, '*');
  }
}

// Intercept: store last fetched data for postMessage
const _origTauriGet = tauriGet;
const _pollCache = Object.create(null);
async function tauriGetCached(cmd) {
  const v = await _origTauriGet(cmd);
  if (v !== null) _pollCache[cmd] = v;
  return v ?? _pollCache[cmd] ?? null;
}

// Replace tauriGet with cached version (no double-fetch when HUD is embedded)
// HUD iframe listens for postMessage and skips its own poll when data arrives

refreshAll();
setInterval(refreshAll, 2500);

// ---- Gridstack movable-panel workspace (drag/resize/persist) ----
(function initLayout() {
  if (typeof GridStack === 'undefined') return;   // graceful if vendor missing
  const LS_KEY = 'atelier.layout.v3';   // v3: model-based (own source of truth)
  // VIS_ROWS rows fill the viewport (cell height is sized to them, so existing panels
  // keep their size); ROWS is the larger maxRow that lets a 3rd row (routing) live below,
  // reachable by scrolling — see .grid-stack overflow-y:auto.
  const COLS = 12, VIS_ROWS = 12, ROWS = 17, MARGIN = 4, MIN_COL = 2, MIN_ROW = 2;
  const cellH = () => Math.max(40, Math.floor((window.innerHeight - (VIS_ROWS + 1) * MARGIN) / VIS_ROWS));
  const grid = GridStack.init({
    column: COLS, maxRow: ROWS, cellHeight: cellH(), margin: MARGIN,
    float: true,             // WE place every panel via render(); gridstack never auto-arranges
    animate: false,          // INSTANT resize — animation made charts read the old size mid-tween
                             // ("only resizes on restart"), so panels snap to final size at once
    staticGrid: true,        // start LOCKED
    handle: '.phead',        // move a panel by its header
  });
  grid.enableResize(false);  // resize is driven by our seam gutters, not gridstack handles

  // affordances: grip in each header + edit hint
  document.querySelectorAll('.grid-stack-item').forEach(it => {
    const head = it.querySelector('.phead');
    if (head && !head.querySelector('.grip')) {
      const g = document.createElement('span');
      g.className = 'grip'; g.textContent = '⠿'; g.title = 'drag to move';
      head.insertBefore(g, head.firstChild);
    }
  });
  const hint = document.createElement('div');
  hint.className = 'edit-hint';
  hint.textContent = 'Edit mode — drag a header (⠿) onto a panel to SWAP or onto its edge to INSERT between · drag a seam to resize · Lock when done';
  document.body.appendChild(hint);

  const PANEL_IDS = [...document.querySelectorAll('.grid-stack-item')].map(it => it.getAttribute('gs-id'));
  const gsEl = document.querySelector('.grid-stack');

  // ===== layout MODEL = single source of truth =====
  // M.rows: [{ h, cols:[{id,w}] }]  — sum(cols.w)=COLS per row, sum(rows.h)=ROWS
  function defaultModel() {
    return { rows: [
      { h: 6, cols: [{ id: 'memory-panel', w: 4 }, { id: 'tenants-panel', w: 4 }, { id: 'tasks-panel', w: 4 }] },
      { h: 6, cols: [{ id: 'hud-pie', w: 4 }, { id: 'hud-lines', w: 4 }, { id: 'hud-status', w: 4 }] },
    ] };
  }
  function validModel(m) {
    if (!m || !Array.isArray(m.rows) || m.rows.length < 1) return false;
    const ids = m.rows.flatMap(r => (r.cols || []).map(c => c.id));
    return ids.length === PANEL_IDS.length && PANEL_IDS.every(id => ids.includes(id));
  }
  let M = defaultModel();
  try { const s = JSON.parse(localStorage.getItem(LS_KEY) || 'null'); if (validModel(s)) M = s; } catch (_) {}

  const resizeCharts = (el) =>
    (el ? [el] : document.querySelectorAll('.grid-stack-item')).forEach(it =>
      it.querySelectorAll('canvas').forEach(c => window.Chart?.getChart?.(c)?.resize()));
  const tauriInvoke = (cmd, args) => {
    const inv = window.__TAURI__?.core?.invoke ?? window.__TAURI__?.invoke ?? window.__TAURI_INTERNALS__?.invoke;
    try { return inv ? inv(cmd, args) : null; } catch (_) { return null; }
  };
  const saveModel = () => {
    const data = JSON.stringify(M);
    try { localStorage.setItem(LS_KEY, data); } catch (_) {}   // fast path / browser preview
    tauriInvoke('save_layout', { data });                      // DURABLE file (survives app quit)
  };

  // make every row sum to COLS and the rows sum to ROWS (equalize anything off / w:0)
  function normalize() {
    M.rows = M.rows.filter(r => r.cols && r.cols.length);   // drop empty rows
    if (!M.rows.length) M = defaultModel();
    const nR = M.rows.length;
    let hbase = Math.floor(ROWS / nR), hrem = ROWS - hbase * nR;
    M.rows.forEach(r => {
      const hsum = r.h || 0;
      if (M.rows.length !== 2 || hsum < MIN_ROW || hsum > ROWS - MIN_ROW) { r.h = hbase + (hrem > 0 ? 1 : 0); if (hrem > 0) hrem--; }
    });
    let totH = M.rows.reduce((s, r) => s + r.h, 0);
    if (totH !== ROWS) M.rows[M.rows.length - 1].h += (ROWS - totH);
    M.rows.forEach(r => {
      const n = r.cols.length;
      const wsum = r.cols.reduce((s, c) => s + (c.w || 0), 0);
      if (wsum !== COLS || r.cols.some(c => !c.w || c.w < MIN_COL)) {
        const base = Math.floor(COLS / n); let rem = COLS - base * n;
        r.cols.forEach(c => { c.w = base + (rem > 0 ? 1 : 0); if (rem > 0) rem--; });
      }
    });
  }

  let _busy = false;
  function render() {
    normalize();
    const layout = []; let y = 0;
    M.rows.forEach(r => { let x = 0; r.cols.forEach(c => { layout.push({ id: c.id, x, y, w: c.w, h: r.h }); x += c.w; }); y += r.h; });
    _busy = true; grid.load(layout); _busy = false;
    saveModel();
    requestAnimationFrame(() => { resizeCharts(); rebuildGutters(); });
    setTimeout(() => { resizeCharts(); rebuildGutters(); }, 90);   // settle fallback
  }

  function findCell(id) {
    for (let ri = 0; ri < M.rows.length; ri++) { const ci = M.rows[ri].cols.findIndex(c => c.id === id); if (ci >= 0) return { ri, ci }; }
    return null;
  }

  // ===== resize =====
  function widthResize(ri, ci, startW, dCols) {
    const row = M.rows[ri]; const k = row.cols.length - 1; if (k < 1) return;
    const maxW = COLS - k * MIN_COL;
    const newW = Math.max(MIN_COL, Math.min(maxW, startW + dCols));
    let leftover = COLS - newW, base = Math.floor(leftover / k), rem = leftover - base * k;
    row.cols.forEach((c, i) => { if (i === ci) c.w = newW; else { c.w = base + (rem > 0 ? 1 : 0); if (rem > 0) rem--; } });
    render();
  }
  function heightResize(startTopH, dRows) {
    if (M.rows.length < 2) return;
    const topH = Math.max(MIN_ROW, Math.min(ROWS - MIN_ROW, startTopH + dRows));
    M.rows[0].h = topH; M.rows[1].h = ROWS - topH;
    render();
  }

  // ===== move: swap (drop on panel center) or insert (drop near an edge) =====
  function moveTo(dragId, targetRi, targetCi, mode) {
    const a = findCell(dragId); if (!a) return;
    if (mode === 'swap') {
      const ca = M.rows[a.ri].cols[a.ci], cb = M.rows[targetRi].cols[targetCi];
      if (!cb || ca === cb) return;
      const tmp = ca.id; ca.id = cb.id; cb.id = tmp;          // swap ids, keep slot widths
    } else { // insert
      const [cell] = M.rows[a.ri].cols.splice(a.ci, 1);
      let tci = targetCi;
      if (a.ri === targetRi && a.ci < targetCi) tci--;        // removal shifted target
      M.rows[targetRi].cols.splice(tci, 0, { id: cell.id, w: 0 }); // w normalized to equal
    }
    render();
  }

  // ===== seam gutters (computed from the model) =====
  const gutterOverlay = document.createElement('div');
  gutterOverlay.className = 'gutter-overlay';
  gsEl.appendChild(gutterOverlay);

  function attachGutterDrag(g) {
    g.addEventListener('pointerdown', (ev) => {
      ev.preventDefault();
      g.classList.add('dragging');
      try { g.setPointerCapture(ev.pointerId); } catch (_) {}
      const rect = gsEl.getBoundingClientRect();
      const cellW = rect.width / COLS, cellHpx = rect.height / ROWS;
      const startX = ev.clientX, startY = ev.clientY;
      const sW = g._kind === 'v' ? M.rows[g._ri].cols[g._ci].w : 0;
      const sTopH = M.rows[0] ? M.rows[0].h : 6;
      let _raf = 0;
      const move = (e) => {
        if (_raf) return;
        _raf = requestAnimationFrame(() => {
          _raf = 0;
          if (g._kind === 'v') widthResize(g._ri, g._ci, sW, Math.round((e.clientX - startX) / cellW));
          else heightResize(sTopH, Math.round((e.clientY - startY) / cellHpx));
        });
      };
      const up = () => {
        g.classList.remove('dragging');
        window.removeEventListener('pointermove', move);
        window.removeEventListener('pointerup', up);
      };
      window.addEventListener('pointermove', move);
      window.addEventListener('pointerup', up);
    });
  }
  function rebuildGutters() {
    gutterOverlay.innerHTML = '';
    if (!document.body.classList.contains('layout-edit')) return;
    const items = {}; document.querySelectorAll('.grid-stack-item').forEach(it => items[it.getAttribute('gs-id')] = it);
    let y = 0;
    M.rows.forEach((r, ri) => {
      for (let ci = 0; ci < r.cols.length - 1; ci++) {
        const leftEl = items[r.cols[ci].id]; if (!leftEl) continue;
        const g = document.createElement('div');
        g.className = 'gutter gutter-v';
        g.style.left = (leftEl.offsetLeft + leftEl.offsetWidth) + 'px';
        g.style.top = leftEl.offsetTop + 'px';
        g.style.height = leftEl.offsetHeight + 'px';
        g._kind = 'v'; g._ri = ri; g._ci = ci;
        gutterOverlay.appendChild(g); attachGutterDrag(g);
      }
    });
    if (M.rows.length >= 2) {
      const ref = items[M.rows[0].cols[0].id];
      if (ref) {
        const g = document.createElement('div');
        g.className = 'gutter gutter-h';
        g.style.top = (ref.offsetTop + ref.offsetHeight) + 'px';
        g.style.left = '0'; g.style.width = '100%';
        g._kind = 'h';
        gutterOverlay.appendChild(g); attachGutterDrag(g);
      }
    }
  }

  // ===== move via header drag: decide swap vs insert on drop =====
  let _dragId = null;
  grid.on('dragstart', (e, el) => { _dragId = el.getAttribute('gs-id'); });
  grid.on('dragstop', (e, el) => {
    if (_dragId && !_busy) {
      const d = el.gridstackNode;
      const cx = d.x + d.w / 2, cy = d.y + d.h / 2;        // drop center (grid units)
      // which row band?  (cumulative heights)
      let yy = 0, targetRi = -1;
      for (let ri = 0; ri < M.rows.length; ri++) { if (cy >= yy && cy < yy + M.rows[ri].h) { targetRi = ri; break; } yy += M.rows[ri].h; }
      if (targetRi >= 0) {
        const row = M.rows[targetRi];
        let xx = 0, overCi = -1;
        for (let ci = 0; ci < row.cols.length; ci++) { if (cx >= xx && cx < xx + row.cols[ci].w) { overCi = ci; break; } xx += row.cols[ci].w; }
        if (overCi >= 0 && row.cols[overCi].id !== _dragId) {
          const cw = row.cols[overCi].w, rel = (cx - xx) / cw;   // 0..1 across the target cell
          if (rel < 0.34) moveTo(_dragId, targetRi, overCi, 'insert');        // left edge → insert before
          else if (rel > 0.66) moveTo(_dragId, targetRi, overCi + 1, 'insert'); // right edge → insert after
          else moveTo(_dragId, targetRi, overCi, 'swap');                     // center → swap
        } else { render(); }   // dropped on itself → snap back
      } else { render(); }
    }
    _dragId = null;
  });

  // ===== toolbar: Edit / Lock / Reset =====
  const bar = document.createElement('div'); bar.className = 'layout-bar';
  const editBtn = document.createElement('button'); editBtn.textContent = '✎ Edit Layout';
  const resetBtn = document.createElement('button'); resetBtn.textContent = '⟲ Reset';
  bar.append(editBtn, resetBtn); document.body.appendChild(bar);
  let editing = false;
  editBtn.addEventListener('click', () => {
    editing = !editing;
    grid.setStatic(!editing);
    if (editing) grid.enableResize(false);
    document.body.classList.toggle('layout-edit', editing);
    editBtn.classList.toggle('active', editing);
    editBtn.textContent = editing ? '🔒 Lock Layout' : '✎ Edit Layout';
    resizeCharts(); rebuildGutters();
  });
  resetBtn.addEventListener('click', () => { M = defaultModel(); render(); });

  const fitHeight = () => grid.cellHeight(cellH());
  window.addEventListener('resize', () => { fitHeight(); resizeCharts(); requestAnimationFrame(rebuildGutters); });

  render();                              // instant paint from localStorage/default
  // Durable restore: pull the saved layout from the on-disk file (survives quit)
  // and re-render if it differs from what localStorage gave us.
  (async () => {
    try {
      const data = await tauriInvoke('load_layout');
      if (data) { const s = JSON.parse(data); if (validModel(s)) { M = s; render(); } }
    } catch (_) {}
  })();
  requestAnimationFrame(() => { fitHeight(); resizeCharts(); });
})();

// ---- Toggle: navigate this window to hud.html (same window, replaces view) ----
// hud.html has a "↗ Full View" button that navigates back.
// In Tauri: also resize the window to HUD size.
const hudToggle = document.createElement('button');
hudToggle.id = 'hudToggle';
hudToggle.textContent = '⊞ Mini HUD';
hudToggle.style.cssText = `
  position:fixed; bottom:16px; right:16px; z-index:999;
  background:rgba(14,14,14,0.9); color:#C8A96E;
  border:1px solid rgba(200,169,110,0.35); padding:5px 12px;
  font-family:"SF Mono",monospace; font-size:10px; letter-spacing:0.1em;
  cursor:pointer; text-transform:uppercase;
`;
document.body.appendChild(hudToggle);

hudToggle.addEventListener('click', async () => {
  // Resize window to HUD size in Tauri, then navigate
  try {
    const inv = window.__TAURI__?.core?.invoke ?? window.__TAURI_INTERNALS__?.invoke;
    if (inv) await inv('resize_to_hud');
  } catch {}
  window.location.href = 'hud.html';
});
</script>
</body>
</html>