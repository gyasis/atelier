{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AtelierDashboard",
  "version": "0.1.0",
  "identifier": "io.atelier.dashboard",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "python3 -m http.server 1420",
      "cwd": "../ui",
      "wait": false
    }
  },
  "app": {
    "windows": [
      {
        "title": "Atelier",
        "width": 1440,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "trayIcon": {
      "id": "atelier-tray",
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": true,
      "tooltip": "Atelier"
    },
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
